# Renewly — configuration example.
# Copy this file to `.env` (install.sh does it for you). Every value below has a
# working default in code, so the app also boots with no `.env` at all.

# Session-signing key. install.sh writes a fresh random key here on first run.
# Leave empty to use the documented development key (not for public servers).
SECRET_KEY=

# SQLite file used for accounts and subscriptions, relative to the project root.
DATABASE_URL=sqlite:///./renewly.db

# Login throttle: 10 failed attempts per IP within 5 minutes. Set to "off"
# only for automated test runs.
RENEWLY_RATE_LIMIT=on
